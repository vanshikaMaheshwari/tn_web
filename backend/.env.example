# Copy to .env and fill in. Never commit .env.
PORT=8000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/techneeds
JWT_SECRET=change-me-to-a-long-random-string

# Admin console login (no admin user is stored in the DB)
ADMIN_EMAIL=admin@techneeds.dev
ADMIN_PASSWORD=change-me

# Comma-separated list of allowed frontend origins (leave empty to allow all in dev)
CORS_ORIGIN=http://localhost:3000

# AI profile — free key from https://aistudio.google.com/apikey
# Without it the profile uses the built-in rule-based generator.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
