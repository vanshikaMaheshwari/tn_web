# Copy to .env and fill in. Never commit .env.
PORT=8000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/techneeds
JWT_SECRET=change-me-to-a-long-random-string

# Core team: mentor accounts with these emails get admin tools (Command deck,
# Events, Inbox) inside Mission Control. Others can be added from Command deck.
ADMIN_EMAILS=mentor@techneeds.dev

# Comma-separated list of allowed frontend origins (leave empty to allow all in dev)
CORS_ORIGIN=http://localhost:3000

# AI profile — free key from https://aistudio.google.com/apikey
# Without it the profile uses the built-in rule-based generator.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order if the main model is busy (503) or rate-limited (429)
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash-lite

# Render Workflows (optional). When both are set, AI cards are generated as
# background task runs on Render with automatic retries; otherwise inline.
RENDER_API_KEY=
AI_WORKFLOW_SLUG=techneeds-ai

# Only if your network blocks mongodb+srv lookups (querySrv ECONNREFUSED)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Scheduled automations (daily deadline digest, weekly cohort report).
# Any long random string; put the same value in GitHub → Settings → Secrets → CRON_SECRET.
CRON_SECRET=
